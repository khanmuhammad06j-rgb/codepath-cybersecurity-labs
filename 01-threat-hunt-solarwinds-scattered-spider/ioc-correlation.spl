```Keep only indicators that appear in BOTH the IOC list and the traffic log.```
source="IOCs_SolarWinds.csv" OR source="TrafficLog_SolarWinds.csv"
| stats values(source) as sources,
        values("Computer Name") as ComputerName,
        values("User Agent") as UserAgent,
        values(Date) as Date,
        values(Time) as Time
  by "IP Address"
| where mvcount(sources) > 1
| table "IP Address", ComputerName, UserAgent, Date, Time
